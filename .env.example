# Runtime configuration (see apps/api/src/kernel/config.ts for every option)
NODE_ENV=development
PORT=3000
# Omit DATABASE_URL to run on in-process PGlite (development only). Set PGLITE_DATA_DIR to persist it.
# DATABASE_URL=postgres://sportspark:sportspark@localhost:5432/sportspark
# PGLITE_DATA_DIR=.pglite
AUTH_MODE=local
# Development and tests only; required. Generate a private value: openssl rand -hex 32
AUTH_LOCAL_SECRET=
LOG_LEVEL=log

# Client compatibility (SPK-AT-027, §4.13). Proposed: the minimum supported build per app and
# platform is pending DEC-061 and the CLIENT_UPDATE_REQUIRED answer is DEC-092, so nothing is
# enforced by default. Format: <mobile|staff>-<ios|android|web>=<major.minor.patch>,...
# CLIENT_MIN_VERSIONS=mobile-ios=1.3.0,mobile-android=1.3.0

# Browser origins allowed to call the API cross-origin (exact origins, comma-separated). Unset:
# CORS off (same-origin hosting). Which origins serve the staff dashboard is DEC-021 (pending);
# production refuses '*' and http:// origins.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CORS_MAX_AGE_SECONDS=600

# Largest request body the API reads, in bytes (default 2 MiB: a contract-maximum offline batch).
# A larger body answers 400 VALIDATION_FAILED (details.code body_too_large); stage large imports
# in chunks or raise this for the migration window.
# HTTP_BODY_LIMIT_BYTES=2097152

# Deepest nesting of objects and arrays a request body may have (default 64). A deeper body answers
# 400 VALIDATION_FAILED (details.code body_too_deep).
# HTTP_BODY_MAX_DEPTH=64
