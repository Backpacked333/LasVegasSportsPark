# Runtime configuration (see apps/api/src/kernel/config.ts for every option)
NODE_ENV=development
PORT=3000
# Omit DATABASE_URL to run on in-process PGlite (development only). Set PGLITE_DATA_DIR to persist it.
# DATABASE_URL=postgres://sportspark:sportspark@localhost:5432/sportspark
# PGLITE_DATA_DIR=.pglite
AUTH_MODE=local
# Development and tests only; required. Generate a private value: openssl rand -hex 32
AUTH_LOCAL_SECRET=
LOG_LEVEL=log

# Managed identity (AUTH_MODE=oidc; spec §5.2, DEC-018). Tokens are verified against the provider's
# JSON Web Key Set; the adapter registers only when PROVIDER_DECISIONS names the identity decision.
# AUTH_MODE=oidc
# AUTH_JWKS_URL=https://<identity provider>/.well-known/jwks.json
# AUTH_ISSUER=https://<identity provider issuer>
# AUTH_AUDIENCE=<audience the provider puts in access tokens>
# AUTH_ALLOWED_ALGS=RS256,ES256
# PROVIDER_DECISIONS=identity=DEC-018

# Provider-selection gates (spec §5.2): fake (development and tests only) or none (no provider
# selected; the port refuses its work with a recorded failure). Unset means fake outside production;
# production refuses an unset or fake selector.
# PAYMENT_PROVIDER=none          # DEC-019
# ACCOUNTING_PROVIDER=none       # DEC-022
# ACCESS_DEVICE_PROVIDER=none    # DEC-023
# MESSAGING_PUSH_PROVIDER=none   # DEC-020
# MESSAGING_EMAIL_PROVIDER=none  # DEC-020
# MESSAGING_SMS_PROVIDER=none    # DEC-020

# Client compatibility (SPK-AT-027, §4.13). Proposed: the minimum supported build per app and
# platform is pending DEC-061 and the CLIENT_UPDATE_REQUIRED answer is DEC-092, so nothing is
# enforced by default. Format: <mobile|staff>-<ios|android|web>=<major.minor.patch>,...
# CLIENT_MIN_VERSIONS=mobile-ios=1.3.0,mobile-android=1.3.0

# Browser origins allowed to call the API cross-origin (exact origins, comma-separated). Unset:
# CORS off (same-origin hosting). Which origins serve the staff dashboard is DEC-021 (pending);
# production refuses '*' and http:// origins.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CORS_MAX_AGE_SECONDS=600

# Largest request body the API reads, in bytes (default 2 MiB: a contract-maximum offline batch).
# A larger body answers 400 VALIDATION_FAILED (details.code body_too_large); stage large imports
# in chunks or raise this for the migration window.
# HTTP_BODY_LIMIT_BYTES=2097152

# Deepest nesting of objects and arrays a request body may have (default 64). A deeper body answers
# 400 VALIDATION_FAILED (details.code body_too_deep).
# HTTP_BODY_MAX_DEPTH=64

# Database transport and pool (§4.14 encrypted transport). Production refuses DATABASE_SSL=disable
# and a plaintext connection to a database on another host.
# DATABASE_SSL=require            # disable | require | verify-full
# DATABASE_SSL_CA_PATH=/etc/ssl/certs/database-ca.pem
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# Behind a load balancer or proxy: which forwarded headers to trust for the client address
# (rate limits) and for https (Strict-Transport-Security). Unset: forwarded headers are ignored.
# TRUST_PROXY=1

# Named rate limits, <name>=<limit>/<seconds> (dev_tokens, claims, invitations, account_recovery,
# account_registration). The store is postgres in production unless set, memory elsewhere.
# RATE_LIMITS=account_registration=60/600
# RATE_LIMIT_STORE=postgres

# Secrets (set them in the host's secret store, never in a committed file):
# METRICS_TOKEN=<at least 24 characters>        # enables GET /v1/metrics for the monitoring service
# DEV_TOKENS_PASSCODE=<at least 16 characters>  # protected staging only: required for /v1/dev/tokens

# Log output: json in production unless set.
# LOG_FORMAT=json

# Client builds (public identifiers, not secrets). Managed sign-in (DEC-018) is offered only by a
# build that names the identity provider; the organization slug is where a first sign-in registers
# its login account.
#   Staff dashboard (apps/staff):  VITE_AUTH_ISSUER, VITE_AUTH_CLIENT_ID, VITE_AUTH_AUDIENCE,
#                                  VITE_AUTH_SCOPE, VITE_AUTH_BEARER, VITE_ORGANIZATION_SLUG
#   Customer app (apps/mobile):    SPORTSPARK_AUTH_ISSUER, SPORTSPARK_AUTH_CLIENT_ID,
#                                  SPORTSPARK_AUTH_AUDIENCE, SPORTSPARK_AUTH_SCOPE,
#                                  SPORTSPARK_AUTH_BEARER, SPORTSPARK_ORGANIZATION_SLUG
