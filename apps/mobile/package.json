{
  "name": "@sportspark/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Sportspark customer app for iOS and Android (Expo, React Native, Expo Router; spec §2.2, §4.1)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "export:ios": "expo export --platform ios --output-dir dist && node scripts/check-release-bundle.mjs dist",
    "export:android": "expo export --platform android --output-dir dist && node scripts/check-release-bundle.mjs dist"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "0.4.2",
    "@expo-google-fonts/archivo-narrow": "0.4.2",
    "@expo-google-fonts/material-symbols": "0.4.53",
    "@expo/log-box": "57.0.4",
    "@expo/metro-runtime": "57.0.16",
    "@sportspark/api-client": "workspace:*",
    "@tanstack/react-query": "5.106.1",
    "expo": "57.0.32",
    "expo-constants": "57.0.23",
    "expo-crypto": "57.0.4",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.13",
    "expo-network": "57.0.3",
    "expo-router": "57.0.30",
    "expo-secure-store": "57.0.4",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.3.1"
  }
}
