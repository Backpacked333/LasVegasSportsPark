{
  "name": "@sportspark/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed HTTP client for the Sportspark API, generated from docs/api/openapi.json (spec §4.8 to §4.10)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@sportspark/contracts": "workspace:*",
    "openapi-typescript": "7.13.0"
  }
}
